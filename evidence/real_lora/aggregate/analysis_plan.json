      "gradient_norm",
      "spectral_effective",
      "eva_activation",
      "fim_gradient_variance",
      "gora_sensitivity"
    ],
    "include_identity_control": true,
    "identity_tolerance": 1e-7,
    "minimum_first_step_gradient_l2": 0.0,
    "minimum_adapter_delta_l2": 0.0,
    "minimum_effective_update_l2": 0.0,
    "deterministic_algorithms": true
