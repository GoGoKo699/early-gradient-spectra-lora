  "input_manifest": "INPUT_MANIFEST.json",
  "input_manifest_sha256": "3479dc2f31c11e0c0bac46e200ac459926ac07deaaa201ac03b342234948a29a",
  "model": {
    "argument": "models/gpt2_local",
    "local_files_only": true
  },
  "dataset": {
    "mode": "local",
    "train_text_file": "data/wikitext2_local/train.txt",
    "val_text_file": "data/wikitext2_local/validation.txt"
  },
  "suites": [
    {
      "suite_id": "cattn_cfc",
      "role": "primary",
      "seeds": [101, 103, 107, 109, 113, 127, 131, 137],
      "target_suffixes": "c_attn,c_fc",
      "max_targets": 0
    },
    {
      "suite_id": "attnproj",
      "role": "boundary",
      "seeds": [101, 103, 107],
      "target_suffixes": "c_attn,attn.c_proj,c_fc",
      "max_targets": 0
    }
  ],
  "run": {
    "block_size": 128,
    "batch_size": 4,
    "calib_batches": 8,
    "eval_batches": 32,
    "steps": 200,
    "lr": 0.0002,
    "weight_decay": 0.0,
    "grad_clip": 1.0,
    "uniform_rank": 4,
    "min_rank": 1,
    "max_rank": 16,
    "fisher_reference_rank": 4,
    "ridge_scale": 0.001,
    "lora_alpha_scale": 2.0,
    "lora_init_std": 0.01,
    "max_train_texts": 5000,
    "max_val_texts": 1000,
    "max_train_blocks": 1024,
    "max_val_blocks": 256,
    "dtype": "float32",
    "device": "cuda",
    "log_every": 20,
    "strategies": [
