    "primary_reference_requested_strategy": "uniform",
    "independent_unit": "suite_seed_run",
    "delta_definition": "candidate_minus_reference",
    "lower_is_better": true,
    "primary_estimand": "Mean paired final-validation-loss difference, spectral_effective minus the exact-cost uniform rank-4 reference, across eight prespecified c_attn/c_fc base-seed runs. Lower is better. The attention-output-projection suite and all other allocation rules are secondary or boundary analyses and are not pooled with the primary suite.",
    "confidence": 0.95,
    "two_sided_alpha": 0.05,
    "bootstrap_resamples": 10000,
    "exact_sign_flip_test": "two_sided_within_suite_nonzero_deltas",
    "secondary_multiplicity": "holm_within_suite",
    "boundary_inference": "descriptive_only_not_pooled",
    "minimum_nonzero_primary_deltas_for_resolution": 6,
    "planned_tie_tolerance": 2
  }
}
